{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-payments.example/integrations/upstream/source-lock.schema.json",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": "upstream-source-lock-0.1"
    },
    "observedAtUTC": {
      "type": "string",
      "format": "date-time"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "retrieval": {
      "type": "object",
      "properties": {
        "mechanism": {
          "type": "string",
          "minLength": 1
        },
        "allGitBlobHashesMatched": {
          "const": true
        },
        "artifactsVendored": {
          "const": false
        },
        "networkPaymentsPerformed": {
          "const": false
        }
      },
      "required": [
        "mechanism",
        "allGitBlobHashesMatched",
        "artifactsVendored",
        "networkPaymentsPerformed"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "ap2",
              "acp"
            ]
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "selectedRef": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "selection": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "const": "Apache-2.0"
          },
          "licenseArtifactId": {
            "type": "string",
            "minLength": 1
          },
          "observedMainCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "required": [
          "id",
          "repository",
          "commit",
          "selectedRef",
          "version",
          "selection",
          "license",
          "licenseArtifactId",
          "observedMainCommit"
        ],
        "additionalProperties": false
      }
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "sourceId": {
            "enum": [
              "ap2",
              "acp"
            ]
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "path": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_./-]+$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "immutableRawUrl": {
            "type": "string",
            "format": "uri"
          },
          "immutableBrowseUrl": {
            "type": "string",
            "format": "uri"
          },
          "gitBlobSha1": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 1
          },
          "license": {
            "const": "Apache-2.0"
          },
          "role": {
            "enum": [
              "license",
              "schema",
              "http-contract",
              "rfc-context",
              "release-notes",
              "normative-document",
              "provenance"
            ]
          }
        },
        "required": [
          "id",
          "sourceId",
          "repository",
          "commit",
          "path",
          "version",
          "immutableRawUrl",
          "immutableBrowseUrl",
          "gitBlobSha1",
          "sha256",
          "byteLength",
          "license",
          "role"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "formatVersion",
    "observedAtUTC",
    "purpose",
    "retrieval",
    "sources",
    "exclusions",
    "artifacts"
  ],
  "additionalProperties": false
}
