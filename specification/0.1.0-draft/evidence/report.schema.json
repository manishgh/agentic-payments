{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-payments.example/evidence/report.schema.json",
  "type": "object",
  "properties": {
    "evidenceVersion": {
      "const": "reference-evidence-0.2"
    },
    "evidenceRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^(?:[0-9a-f]{32})(?![\\s\\S])"
    },
    "extensionVersion": {
      "const": "0.1.0-draft"
    },
    "contractVersion": {
      "const": "simulator-api-0.1-draft"
    },
    "profile": {
      "const": "local-fake-single-tender-0.1"
    },
    "source": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])"
        },
        "files": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^(?:[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*)(?![\\s\\S])"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])"
          },
          "minProperties": 1,
          "maxProperties": 2000
        }
      },
      "required": [
        "sha256",
        "files"
      ],
      "additionalProperties": false
    },
    "sourceBeforeSha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])"
    },
    "sourceUnchangedDuringChecks": {
      "type": "boolean"
    },
    "inputHashes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300,
        "pattern": "^(?:[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*)(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])"
      },
      "minProperties": 1,
      "maxProperties": 2000
    },
    "runtimeVersions": {
      "type": "object",
      "properties": {
        "java": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "^(?:[0-9A-Za-z.+_-]{1,60})(?![\\s\\S])"
        },
        "maven": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "^(?:[0-9A-Za-z.+_-]{1,60})(?![\\s\\S])"
        },
        "node": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "^(?:[0-9A-Za-z.+_-]{1,60})(?![\\s\\S])"
        },
        "python": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "^(?:[0-9A-Za-z.+_-]{1,60})(?![\\s\\S])"
        }
      },
      "required": [
        "java",
        "maven",
        "node",
        "python"
      ],
      "additionalProperties": false
    },
    "buildArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "reference-jar",
              "adapter-sdk"
            ]
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])"
          }
        },
        "required": [
          "id",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 2,
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "enum": [
              "contracts",
              "evidence-tooling",
              "upstream-integrity",
              "upstream-structural",
              "offline-artifacts",
              "offline-artifact-demo",
              "java-postgresql",
              "adapter-tck",
              "recorded-replay",
              "trusted-ui",
              "http",
              "langgraph"
            ]
          },
          "executionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^(?:[0-9a-f]{32})(?![\\s\\S])"
          },
          "outcome": {
            "enum": [
              "PASS",
              "FAIL",
              "INCOMPLETE"
            ]
          },
          "exitCode": {
            "type": "integer",
            "minimum": -9999999999,
            "maximum": 9999999999
          },
          "durationSeconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 86400
          },
          "artifact": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^(?:artifacts/[a-z][a-z-]{0,63}\\.json)(?![\\s\\S])"
                  },
                  "sha256": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "executionId",
          "outcome",
          "exitCode",
          "durationSeconds",
          "artifact"
        ],
        "additionalProperties": false
      },
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^(?:[A-Z][A-Z0-9-]{1,95})(?![\\s\\S])"
          },
          "stage": {
            "enum": [
              "contracts",
              "evidence-tooling",
              "upstream-integrity",
              "upstream-structural",
              "offline-artifacts",
              "offline-artifact-demo",
              "java-postgresql",
              "adapter-tck",
              "recorded-replay",
              "trusted-ui",
              "http",
              "langgraph"
            ]
          },
          "observedStatus": {
            "enum": [
              "PASS",
              "FAIL",
              "ERROR",
              "SKIPPED",
              "EXPECTED_FAILURE",
              "UNEXPECTED_SUCCESS",
              "MISSING"
            ]
          },
          "qualifiedStatus": {
            "enum": [
              "PASS",
              "FAIL",
              "INCOMPLETE"
            ]
          },
          "reason": {
            "enum": [
              "MISSING_ARTIFACT",
              "INVALID_PRODUCER",
              "ASSERTION_FAILED",
              "SOURCE_CHANGED",
              "STAGE_NOT_PASSED",
              "INCOMPLETE_PRODUCER",
              "ASSERTION_NOT_PASSED",
              "OBSERVED_PASS"
            ]
          }
        },
        "required": [
          "id",
          "stage",
          "observedStatus",
          "qualifiedStatus",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true
    },
